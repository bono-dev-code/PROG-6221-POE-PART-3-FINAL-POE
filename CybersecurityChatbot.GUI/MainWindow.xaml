<!-- Main window for the chatbot application -->
<Window x:Class="CybersecurityChatbot.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot"
        Height="680"
        Width="1100"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0F172A">

    <!-- Styles used in the application -->
    <Window.Resources>

        <!-- Main sidebar button style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Custom button design -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10">

                            <!-- Displays button text -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red button style -->
        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <!-- Green button style -->
        <Style x:Key="SuccessButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

    </Window.Resources>

    <!-- Main layout grid -->
    <Grid Margin="12">

        <!-- Create two columns -->
        <Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <ColumnDefinition Width="250"/>

            <!-- Main chat area -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="#111827"
                CornerRadius="14"
                Padding="14"
                Margin="0,0,12,0">

            <!-- Makes sidebar scrollable -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- Sidebar title -->
                    <TextBlock Text="CHATBOT MENU"
                               Foreground="#22D3EE"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <!-- User name label -->
                    <TextBlock Text="Name"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <!-- User name input -->
                    <TextBox x:Name="NameInput"
                             Height="36"
                             Padding="8"
                             Text=""/>

                    <!-- Set user name button -->
                    <Button Content="Set Name"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,10,0,14"
                            Click="SetName_Click"/>

                    <!-- Quick topics section -->
                    <TextBlock Text="Quick Topics"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <!-- Quick topic buttons -->
                    <Button Content="Password Safety"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="Phishing"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="Privacy"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="Malware"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="2FA"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <!-- Task assistant section -->
                    <TextBlock Text="Task Assistant"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,12,0,8"/>

                    <!-- Task buttons -->
                    <Button Content="Add Demo Task"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="AddTask_Click"/>

                    <Button Content="View Tasks"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ViewTasks_Click"/>

                    <Button Content="Mark Task Complete"
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="MarkTaskComplete_Click"/>

                    <Button Content="Delete Task"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="DeleteTask_Click"/>

                    <!-- Task ID label -->
                    <TextBlock Text="Task ID"
                               Foreground="White"
                               Margin="0,10,0,6"/>

                    <!-- Task ID textbox -->
                    <TextBox x:Name="TaskIdTextBox"
                             Height="36"
                             Padding="8"
                             ToolTip="Enter Task ID"/>

                    <!-- Quiz section -->
                    <TextBlock Text="Quiz"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,12,0,8"/>

                    <!-- Quiz buttons -->
                    <Button Content="Start Quiz"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="StartQuiz_Click"/>

                    <Button Content="Quit Quiz"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="QuitQuiz_Click"/>

                    <!-- Logs and memory section -->
                    <TextBlock Text="Logs and Memory"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,12,0,8"/>

                    <!-- Log buttons -->
                    <Button Content="Show Memory"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ShowMemory_Click"/>

                    <Button Content="Show Activity Log"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ShowActivityLog_Click"/>

                    <Button Content="Clear Chat"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ClearChat_Click"/>

                    <!-- Help and hints panel -->
                    <Border Background="#1E293B"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,20,0,0">

                        <StackPanel>

                            <!-- Hint title -->
                            <TextBlock Text="Hints"
                                       Foreground="#67E8F9"
                                       FontWeight="Bold"/>

                            <!-- Example chatbot commands -->
                            <TextBlock Text="• I'm worried about scams"
                                       Foreground="White"
                                       Margin="0,6,0,4"/>

                            <TextBlock Text="• Tell me more"
                                       Foreground="White"/>

                            <TextBlock Text="• Add task Enable 2FA"
                                       Foreground="White"/>

                            <TextBlock Text="• Remind me to update my password tomorrow"
                                       Foreground="White"/>

                            <TextBlock Text="• Start quiz"
                                       Foreground="White"/>

                            <TextBlock Text="• Quit quiz"
                                       Foreground="White"/>

                            <TextBlock Text="• Show activity log"
                                       Foreground="White"/>

                            <TextBlock Text="• View tasks"
                                       Foreground="White"/>

                            <TextBlock Text="• Use Task ID to complete/delete tasks"
                                       Foreground="White"/>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT SIDE MAIN AREA -->
        <Grid Grid.Column="1">

            <!-- Create rows -->
            <Grid.RowDefinitions>

                <!-- Header -->
                <RowDefinition Height="Auto"/>

                <!-- ASCII logo -->
                <RowDefinition Height="Auto"/>

                <!-- Chat area -->
                <RowDefinition Height="*"/>

                <!-- Quiz panel -->
                <RowDefinition Height="Auto"/>

                <!-- Input area -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- Main title section -->
            <Border Background="#111827"
                    CornerRadius="14"
                    Padding="16"
                    MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">

                <StackPanel>

                    <!-- Main chatbot title -->
                    <TextBlock Text="CYBERSECURITY AWARENESS CHATBOT"
                               Foreground="#22D3EE"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <!-- Subtitle -->
                    <TextBlock Text="South Africa Edition"
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                </StackPanel>
            </Border>

            <!-- ASCII art banner -->
            <Border Grid.Row="1"
                    Margin="0,10,0,10"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="10"
                    MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">

                <StackPanel>

                    <!-- ASCII art lines -->
                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text=" ██████╗██╗   ██╗██████╗ ███████╗██████╗ "/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="╚██████╗   ██║   ██████╔╝███████╗██║  ██║"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text=" ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝"/>

                </StackPanel>
            </Border>

            <!-- Chat display area -->
            <Border Grid.Row="2"
                    Background="#111827"
                    CornerRadius="14"
                    Padding="14">

                <!-- Allows scrolling through chat -->
                <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto">

                    <!-- Chat messages appear here -->
                    <StackPanel x:Name="ChatPanel"/>

                </ScrollViewer>
            </Border>

            <!-- Quiz panel -->
            <Border Grid.Row="3"
                    Margin="0,10,0,10"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="10">

                <StackPanel>

                    <!-- Quiz question -->
                    <TextBlock x:Name="QuizQuestionText"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="Quiz panel will appear here when the quiz starts."
                               TextWrapping="Wrap"/>

                    <!-- Quiz answer buttons -->
                    <WrapPanel Margin="0,10,0,0">

                        <Button x:Name="QuizOption1"
                                Content="Option 1"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                        <Button x:Name="QuizOption2"
                                Content="Option 2"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                        <Button x:Name="QuizOption3"
                                Content="Option 3"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                        <Button x:Name="QuizOption4"
                                Content="Option 4"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Bottom input area -->
            <Grid Grid.Row="4">

                <!-- Input columns -->
                <Grid.ColumnDefinitions>

                    <!-- User textbox -->
                    <ColumnDefinition Width="*"/>

                    <!-- Small space -->
                    <ColumnDefinition Width="10"/>

                    <!-- Send button -->
                    <ColumnDefinition Width="130"/>

                </Grid.ColumnDefinitions>

                <!-- User input textbox -->
                <TextBox x:Name="UserInput"
                         Grid.Column="0"
                         Height="44"
                         Padding="10"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInput_KeyDown"/>

                <!-- Send message button -->
                <Button Content="Send"
                        Grid.Column="2"
                        Height="44"
                        Background="#06B6D4"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Click="Send_Click"/>

            </Grid>
        </Grid>
    </Grid>
</Window>