<!-- Main window for the chatbot application -->
<Window x:Class="CybersecurityChatbot.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot"
        Height="680"
        Width="1100"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0F172A">

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <Style x:Key="SuccessButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="#111827"
                CornerRadius="14"
                Padding="14"
                Margin="0,0,12,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="CHATBOT MENU"
                               Foreground="#22D3EE"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Name"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="NameInput"
                             Height="36"
                             Padding="8"
                             Text=""
                             KeyDown="NameInput_KeyDown"/>

                    <Button Content="Set Name"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,10,0,14"
                            Click="SetName_Click"/>

                    <TextBlock Text="Quick Topics"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <Button Content="Password Safety"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="Phishing"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="Privacy"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="Malware"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <Button Content="2FA"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="QuickTopic_Click"/>

                    <!-- Task Assistant -->
                    <TextBlock Text="Task Assistant"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,12,0,8"/>

                    <TextBlock Text="Task Title"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="TaskTitleTextBox"
                             Height="36"
                             Padding="8"
                             Margin="0,0,0,8"
                             ToolTip="Example: Review privacy settings"/>

                    <TextBlock Text="Task Description"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="TaskDescriptionTextBox"
                             Height="70"
                             Padding="8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,8"
                             ToolTip="Write what the user must do"/>

                    <TextBlock Text="Reminder Date Optional"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <DatePicker x:Name="TaskReminderDatePicker"
                                Height="36"
                                Margin="0,0,0,8"/>

                    <Button Content="Add Task"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="AddTask_Click"/>

                    <Button Content="View Tasks"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ViewTasks_Click"/>

                    <Button Content="Mark Selected Complete"
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="MarkTaskComplete_Click"/>

                    <Button Content="Delete Selected Task"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="DeleteTask_Click"/>

                    <!-- Quiz section -->
                    <TextBlock Text="Quiz"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,12,0,8"/>

                    <Button Content="Start Quiz"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="StartQuiz_Click"/>

                    <Button Content="Quit Quiz"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="QuitQuiz_Click"/>

                    <TextBlock Text="Logs and Memory"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,12,0,8"/>

                    <Button Content="Show Memory"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ShowMemory_Click"/>

                    <Button Content="Show Activity Log"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ShowActivityLog_Click"/>

                    <Button Content="Clear Chat"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ClearChat_Click"/>

                    <Border Background="#1E293B"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock Text="Hints"
                                       Foreground="#67E8F9"
                                       FontWeight="Bold"/>

                            <TextBlock Text="• I'm worried about scams"
                                       Foreground="White"
                                       Margin="0,6,0,4"/>

                            <TextBlock Text="• Tell me more"
                                       Foreground="White"/>

                            <TextBlock Text="• Add task Enable 2FA"
                                       Foreground="White"/>

                            <TextBlock Text="• Remind me to update my password tomorrow"
                                       Foreground="White"/>

                            <TextBlock Text="• Start quiz"
                                       Foreground="White"/>

                            <TextBlock Text="• Quit quiz"
                                       Foreground="White"/>

                            <TextBlock Text="• Show activity log"
                                       Foreground="White"/>

                            <TextBlock Text="• View tasks"
                                       Foreground="White"/>

                            <TextBlock Text="• Select a task from the table to complete/delete"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT SIDE MAIN AREA -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#111827"
                    CornerRadius="14"
                    Padding="16"
                    MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">

                <StackPanel>

                    <TextBlock Text="CYBERSECURITY AWARENESS CHATBOT"
                               Foreground="#22D3EE"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="South Africa Edition"
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,10,0,10"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="10"
                    MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">

                <StackPanel>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text=" ██████╗██╗   ██╗██████╗ ███████╗██████╗ "/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="╚██████╗   ██║   ██████╔╝███████╗██║  ██║"/>

                    <TextBlock FontFamily="Consolas"
                               Foreground="#67E8F9"
                               FontSize="13"
                               TextAlignment="Center"
                               Text=" ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝"/>

                </StackPanel>
            </Border>

          
            <!-- Chat display area -->
            <Border Grid.Row="2"
        Background="#111827"
        CornerRadius="14"
        Padding="14">

                <ScrollViewer x:Name="ChatScrollViewer"
                  VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="ChatPanel"/>

                </ScrollViewer>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,10,0,10"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="10">

                <StackPanel>

                    <TextBlock x:Name="QuizQuestionText"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="Quiz panel will appear here when the quiz starts."
                               TextWrapping="Wrap"/>

                    <WrapPanel Margin="0,10,0,0">

                        <Button x:Name="QuizOption1"
                                Content="Option 1"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                        <Button x:Name="QuizOption2"
                                Content="Option 2"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                        <Button x:Name="QuizOption3"
                                Content="Option 3"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                        <Button x:Name="QuizOption4"
                                Content="Option 4"
                                Width="220"
                                Height="34"
                                Margin="0,0,10,8"
                                Click="QuizOption_Click"/>

                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput"
                         Grid.Column="0"
                         Height="44"
                         Padding="10"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInput_KeyDown"/>

                <Button Content="Send"
                        Grid.Column="2"
                        Height="44"
                        Background="#06B6D4"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Click="Send_Click"/>

            </Grid>
        </Grid>
    </Grid>
</Window>