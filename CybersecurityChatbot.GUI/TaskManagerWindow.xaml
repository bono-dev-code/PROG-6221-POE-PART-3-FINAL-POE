<Window x:Class="CybersecurityChatbot.GUI.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0F172A">

    <Window.Resources>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Cybersecurity Task Manager"
                   Foreground="#22D3EE"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,14"/>

        <DataGrid x:Name="TaskDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                  Background="#1E293B"
                  Foreground="White"
                  RowBackground="#1E293B"
                  AlternatingRowBackground="#0F172A"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Task Title"
                                    Binding="{Binding Title}"
                                    Width="220"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>

                <DataGridTextColumn Header="Reminder Date"
                                    Binding="{Binding ReminderDate, StringFormat=yyyy-MM-dd}"
                                    Width="150"/>

                <DataGridCheckBoxColumn Header="Completed"
                                        Binding="{Binding IsCompleted}"
                                        Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button Content="Refresh"
                    Width="110"
                    Height="38"
                    Margin="0,0,8,0"
                    Click="Refresh_Click"/>

            <Button Content="Mark Complete"
                    Width="130"
                    Height="38"
                    Margin="0,0,8,0"
                    Click="MarkComplete_Click"/>

            <Button Content="Delete"
                    Width="110"
                    Height="38"
                    Margin="0,0,8,0"
                    Click="Delete_Click"/>

            <Button Content="Close"
                    Width="110"
                    Height="38"
                    Click="Close_Click"/>

        </StackPanel>
    </Grid>
</Window>