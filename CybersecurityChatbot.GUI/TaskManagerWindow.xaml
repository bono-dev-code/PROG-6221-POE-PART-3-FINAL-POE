<Window x:Class="CybersecurityChatbot.GUI.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager"
        Height="550"
        Width="1100"
        MinWidth="1000"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0F172A">

    <Window.Resources>

        <!-- Header Style -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Heading -->

        <StackPanel>

            <TextBlock Text="Cybersecurity Task Manager"
                       Foreground="#22D3EE"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Manage all cybersecurity reminders and tasks."
                       Foreground="White"
                       Margin="0,6,0,20"/>

        </StackPanel>

        <!-- TASK TABLE -->

        <Border Grid.Row="1"
                Background="#1E293B"
                CornerRadius="10"
                Padding="5">

            <DataGrid x:Name="TaskDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                      Background="#1E293B"
                      Foreground="White"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#162033"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Task Title"
                                        Binding="{Binding Title}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        Width="4*"/>

                    <DataGridTextColumn Header="Reminder Date"
                                        Binding="{Binding ReminderDate,StringFormat=yyyy-MM-dd}"
                                        Width="170"/>

                    <DataGridCheckBoxColumn Header="Completed"
                                            Binding="{Binding IsCompleted}"
                                            Width="110"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- BUTTONS -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Refresh"
                    Width="120"
                    Click="Refresh_Click"/>

            <Button Content="Mark Complete"
                    Width="150"
                    Click="MarkComplete_Click"/>

            <Button Content="Delete"
                    Width="120"
                    Click="Delete_Click"/>

            <Button Content="✖ Close"
                    Width="120"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>